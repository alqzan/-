# إعداد Firebase لمشروع "tafalna" مضمَّن بالفعل كافتراضي داخل
# src/lib/firebase.ts — لا حاجة لهذا الملف في الاستخدام العادي أو في
# النشر على GitHub Pages.
#
# استخدموه فقط لتجاوز الإعداد الافتراضي مؤقتًا (مثلًا: مشروع Firebase
# تجريبي منفصل أثناء التطوير). انسخوا هذا الملف إلى .env.local (مُتجاهَل
# في Git) واملؤوا القيم من: Firebase Console → Project settings →
# General → تطبيقات الويب.
#
# القيم ليست سرّية أصلًا — تُشحن مع أي تطبيق Firebase للويب وتظهر لأي
# زائر. الحماية الفعلية هي قواعد firestore.rules، لا إخفاء هذه المفاتيح.
# لا حاجة لـ VITE_FIREBASE_STORAGE_BUCKET: هذا التطبيق لا يستخدم Firebase
# Storage إطلاقًا (يتطلّب خطة Blaze المدفوعة)، والصور والتسجيلات الصوتية
# تبقى محلية على كل جهاز دائمًا.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
