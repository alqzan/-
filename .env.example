# ============================================================
# إعدادات Firebase — عامة وغير سرّية (تُنسخ من إعدادات المشروع في
# Firebase Console: Project settings → General → Your apps → SDK setup).
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية بعد إنشاء المشروع.
# لا تضع هنا أي مفاتيح خدمة (service account) أو أسرار — هذه القيم
# مخصّصة للعميل (المتصفح) وتُشحن ضمن حزمة الواجهة أصلًا.
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# اختياري (Google Analytics) — اتركه فارغًا إن لم يُفعَّل
VITE_FIREBASE_MEASUREMENT_ID=

# اضبطها إلى "true" أثناء التطوير المحلي لتوجيه SDK لمحاكيات Firebase
# المحلية (firebase emulators:start) بدل مشروع حقيقي.
VITE_FIREBASE_USE_EMULATOR=false
