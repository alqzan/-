rules_version = '2';

// =============================================================
// قواعد الحماية — مزامنة العائلة في «طفلنا».
//
// نموذج البيانات: مستند عائلة واحد لكل رمز مزامنة (٤٣ حرفًا عشوائيًا،
// راجع src/lib/familyCode.ts). لا حسابات ولا كلمات مرور — معرفة الرمز
// نفسه هي التفويض، تمامًا كرابط مشاركة خاص. لذلك:
//   • القراءة المباشرة لمستند معروف الاسم (get) مسموحة لأي مستخدم
//     مسجَّل دخولًا مجهولًا — تخمين ٤٣ حرفًا مستحيل عمليًا.
//   • سرد كل الوثائق (list) ممنوع تمامًا، وإلا صار بالإمكان تعداد
//     رموز كل العائلات الموجودة بلا معرفة أي رمز مسبقًا.
//   • لا صور ولا تسجيلات صوتية تُقبل في أي كتابة — درع أمان إضافي
//     فوق ما يضمنه كود التطبيق نفسه (الذي لا يرسلها أصلًا).
//   • لا حذف من طرف العميل — إيقاف المزامنة يفصل الجهاز فقط ولا يمسّ
//     المستند السحابي، حتى يمكن العودة إليه لاحقًا.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /families/{familyCode} {
      function isAuthed() {
        return request.auth != null;
      }

      // الرمز مُولَّد دائمًا بطول ٤٣ حرفًا (src/lib/familyCode.ts) — رمز
      // بطول مختلف لا يمكن أن يكون رمز عائلة حقيقيًا صادرًا من التطبيق
      function isValidCode() {
        return familyCode.size() == 43;
      }

      function noMediaFields() {
        return !('photos' in request.resource.data)
            && !('voices' in request.resource.data);
      }

      // صورة ملف الطفل (Data URL) وسيط ثقيل أيضًا — تُسقَط قبل الإرسال
      // في الكود (syncableSnapshot)، وهذا يحرس ألا تُقبل لو وصلت بأي حال
      function noChildPhoto() {
        return !('child' in request.resource.data)
            || !('photo' in request.resource.data.child)
            || request.resource.data.child.photo == null;
      }

      allow get: if isAuthed() && isValidCode();
      allow list: if false;
      allow create, update: if isAuthed() && isValidCode() && noMediaFields() && noChildPhoto();
      allow delete: if false;
    }

    // أي مسار آخر غير مذكور أعلاه: ممنوع افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
